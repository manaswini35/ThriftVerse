# Copy to .env and fill in. .env is gitignored; this file is not, so never
# put a real secret in here.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/thriftverse
JWT_SECRET=change-me

# Where the React app runs, for CORS and socket origins.
CLIENT_URL=http://localhost:5173

# Listing photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Virtual try-on ────────────────────────────────────────────
# Which adapter in src/services/virtualTryOn/providers/ to use.
#   demo   - prepared results from src/data/demoTryOns.js. No key, no cost,
#            no network. Results are badged "Demo preview" in the UI.
#   gemini - real generation. Requires GEMINI_API_KEY *and* billing enabled
#            on the Google Cloud project: image models have no free tier.
TRYON_PROVIDER=demo

# Only read when TRYON_PROVIDER=gemini. Get a key at
# https://aistudio.google.com/app/apikey — but note the key alone is NOT
# enough: every Gemini image model returns "free_tier_requests, limit: 0",
# so the project needs billing enabled or every request 429s.
GEMINI_API_KEY=

# Must be an image-output model (note the "-image" suffix) — plain
# gemini-2.5-flash is text-only. gemini-3.1-flash-image is the newer option.
TRYON_MODEL=gemini-2.5-flash-image
